{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/rss.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/rss+xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=600"
        }
      ]
    },
    {
      "source": "/actualites/index.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://www.respi.info"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=600"
        }
      ]
    },
    {
      "source": "/content/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/scripts/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=600, s-maxage=3600"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/assets/styles.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/nav.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/downloads/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/assets/actualites.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "https://www.jooy.info/respi-info",
      "permanent": true
    },
    {
      "source": "/asthme",
      "destination": "https://www.jooy.info/guides/asthme",
      "permanent": true
    },
    {
      "source": "/bpco",
      "destination": "https://www.jooy.info/guides/bpco",
      "permanent": true
    },
    {
      "source": "/fibrose",
      "destination": "https://www.jooy.info/guides/fibrose-pulmonaire",
      "permanent": true
    },
    {
      "source": "/htap",
      "destination": "https://www.jooy.info/guides/htap",
      "permanent": true
    },
    {
      "source": "/bronchectasies",
      "destination": "https://www.jooy.info/guides/bronchectasies",
      "permanent": true
    },
    {
      "source": "/pneumopathie-hypersensibilite",
      "destination": "https://www.jooy.info/guides/pneumopathie-hypersensibilite",
      "permanent": true
    },
    {
      "source": "/mucoviscidose",
      "destination": "https://www.jooy.info/guides/mucoviscidose",
      "permanent": true
    },
    {
      "source": "/fonctionnement",
      "destination": "https://www.jooy.info/respi-fonctionnement",
      "permanent": true
    },
    {
      "source": "/pour-qui",
      "destination": "https://www.jooy.info/respi-patients",
      "permanent": true
    },
    {
      "source": "/faq",
      "destination": "https://www.jooy.info/respi-info",
      "permanent": true
    },
    {
      "source": "/sources",
      "destination": "https://www.jooy.info/guides",
      "permanent": true
    },
    {
      "source": "/partenaires",
      "destination": "https://www.jooy.info/respi-associations",
      "permanent": true
    },
    {
      "source": "/soutenir",
      "destination": "https://www.jooy.info/soutenir",
      "permanent": true
    },
    {
      "source": "/presse",
      "destination": "https://www.jooy.info/respi-communique-presse",
      "permanent": true
    },
    {
      "source": "/telechargements",
      "destination": "https://www.jooy.info/respi-communique-presse",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "https://www.jooy.info/#contact",
      "permanent": true
    },
    {
      "source": "/partenaires-sources",
      "destination": "https://www.jooy.info/guides",
      "permanent": true
    }
  ]
}
